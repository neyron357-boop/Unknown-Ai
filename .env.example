# Скопируйте этот файл в .env и укажите ключ. Ключ используется ТОЛЬКО сервером.
# Без ключа игра работает в локальном деморежиме (заготовленные реплики).
GEMINI_API_KEY=
# Модель можно поменять без правки кода (актуальный список: https://ai.google.dev/gemini-api/docs/models)
GEMINI_MODEL=gemini-3.5-flash-lite
# Порт API-сервера (Vite проксирует /api на него в режиме разработки)
PORT=8787
# Лимит запросов к ИИ на один IP в минуту
AI_RATE_LIMIT_PER_MIN=12

# --- Голоса (Gemini TTS) ---
# Модели TTS по порядку: при исчерпании дневной квоты (429 per-day) сервер переходит к следующей.
GEMINI_TTS_MODELS=gemini-3.8-flash-tts,gemini-3.8-flash-lite-tts,gemini-3.1-flash-tts-preview,gemini-2.5-flash-preview-tts
# Модели для персональных реплик эпизода (/api/ai/episode), JSON-ответ; вторая — запасная.
GEMINI_EPISODE_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite
# Лимит синтеза голоса (/api/ai/voice) на один IP в минуту (кэш-хиты не считаются)
VOICE_RATE_LIMIT_PER_MIN=6
# Потолок обращений к TTS на весь сервер в сутки (защита ключа)
VOICE_DAILY_LIMIT=300
# Дисковый кэш динамических реплик (по умолчанию .cache/voice-dyn в корне проекта)
# VOICE_CACHE_DIR=
# Генератор банка голосов (npm run voice:gen) также читает GEMINI_TTS_MODELS и GEMINI_QA_MODELS
# GEMINI_QA_MODELS=gemini-3.5-flash,gemini-3.8-flash,gemini-3.5-flash-lite,gemini-flash-lite-latest
