# Скопируйте этот файл в .env и укажите ключ. Ключ используется ТОЛЬКО сервером.
# Без ключа игра работает в локальном деморежиме (заготовленные реплики).
GEMINI_API_KEY=
# Модель можно поменять без правки кода (актуальный список: https://ai.google.dev/gemini-api/docs/models)
GEMINI_MODEL=gemini-3.5-flash-lite
# Порт API-сервера (Vite проксирует /api на него в режиме разработки)
PORT=8787
# Лимит запросов к ИИ на один IP в минуту
AI_RATE_LIMIT_PER_MIN=12
